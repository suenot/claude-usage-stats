FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
COPY core/package.json ./core/package.json
COPY backend/package.json ./backend/package.json
COPY frontend/package.json ./frontend/package.json
COPY cli/package.json ./cli/package.json
RUN npm ci --ignore-scripts

COPY core/src ./core/src
COPY core/tsconfig.json ./core/tsconfig.json
COPY backend/src ./backend/src
COPY backend/tsconfig.json ./backend/tsconfig.json
RUN npm run build -w core && npm run build -w backend && npm prune --omit=dev

FROM node:22-alpine

WORKDIR /app
ENV NODE_ENV=production \
    PORT=3001 \
    HOME=/data

COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/core/package.json ./core/package.json
COPY --from=build /app/core/dist ./core/dist
COPY --from=build /app/backend/package.json ./backend/package.json
COPY --from=build /app/backend/dist ./backend/dist

EXPOSE 3001
CMD ["node", "backend/dist/server.js"]
